#!/bin/sh
set -eu

ACTION="${1:-}"
SERVICE="${2:-}"

case "$ACTION" in
  start|stop|restart) ;;
  *)
    echo "allowed actions: start stop restart" >&2
    exit 2
    ;;
esac

if [ "$SERVICE" != "kalshi-recorder.service" ]; then
  echo "service not allowlisted" >&2
  exit 3
fi

exec /usr/bin/systemctl "$ACTION" "$SERVICE"
